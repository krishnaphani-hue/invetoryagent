# Copy to .env (run.bat or scripts/setup_db.ps1 does this for you and fills in the password).
# PostgreSQL runs natively on Windows on port 5433 (no Docker).
DATABASE_URL=postgresql+psycopg://inventory_app:change_me@localhost:5433/asset_inventory
# pytest uses the same server and user with "_test" appended to the database name (asset_inventory_test).

# Where the server listens (scripts/run.ps1, or `python -m app` in backend/).
#   HOST=127.0.0.1  local mode: only this computer (the agent on this laptop sends to http://localhost:8080)
#   HOST=0.0.0.0    hosted mode: other machines can connect (also needs a firewall rule / nginx in front)
HOST=127.0.0.1
APP_PORT=8080

# Shared key agents send in the X-API-Key header to POST /api/v1/inventory. Empty = no key needed.
# Set one before other machines can reach the server. Generate:  python -c "import secrets; print(secrets.token_urlsafe(24))"
INGEST_API_KEY=

# Keep snapshot history this many days (0 = forever). Krishna's agent sends ~288 snapshots/machine/day.
RETENTION_DAYS=30

# A machine is "online" if it sent data within this many minutes.
# With AGENT_DB_URL set, keep this above AGENT_POLL_MINUTES (e.g. 35 for a 30-minute poll), because data then
# arrives once per poll; otherwise machines show offline between polls.
ONLINE_MINUTES=15

MAX_UPLOAD_MB=20

# Bridge while the agent still writes to its own database (direct-DB mode) instead of POSTing to this server:
# the server reads that database every AGENT_POLL_MINUTES and imports cycles collected since the last import
# (no duplicates; source "agent"; original collected_at). Empty = no polling. libpq URL of the agent's database:
# AGENT_DB_URL=postgresql://agent:change_me@localhost:5432/inventory
AGENT_DB_URL=
AGENT_POLL_MINUTES=30

# Optional, only for scripts/setup_db.ps1 (default: the newest PostgreSQL under Program Files):
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
